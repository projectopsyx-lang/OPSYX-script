--// Loader
local loading = false

local function loadScript(url, name)
    if loading then
        return
    end

    loading = true

    Load1.Active = false
    Load2.Active = false

    Status.Text = "Downloading " .. name .. "..."
    Status.TextColor3 = Color3.fromRGB(110, 200, 230)

    local ok, source = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok then
        Status.Text = "Download failed"
        Status.TextColor3 = Color3.fromRGB(255, 100, 110)

        warn("[OPSYX] HTTP error: " .. tostring(source))

        Load1.Active = true
        Load2.Active = true
        loading = false
        return
    end

    if type(source) ~= "string" or #source < 10 then
        Status.Text = "Invalid script response"
        Status.TextColor3 = Color3.fromRGB(255, 100, 110)

        Load1.Active = true
        Load2.Active = true
        loading = false
        return
    end

    Status.Text = "Launching " .. name .. "..."
    Status.TextColor3 = Color3.fromRGB(100, 230, 170)

    local compiler = loadstring or load

    if type(compiler) ~= "function" then
        Status.Text = "loadstring is unavailable"
        Status.TextColor3 = Color3.fromRGB(255, 100, 110)

        Load1.Active = true
        Load2.Active = true
        loading = false
        return
    end

    local success, fn = pcall(function()
        return compiler(source)
    end)

    if not success or type(fn) ~= "function" then
        Status.Text = "Compilation failed"
        Status.TextColor3 = Color3.fromRGB(255, 100, 110)

        warn("[OPSYX] Compile error: " .. tostring(fn))

        Load1.Active = true
        Load2.Active = true
        loading = false
        return
    end

    local runSuccess, runError = pcall(fn)

    if not runSuccess then
        Status.Text = "Script error"
        Status.TextColor3 = Color3.fromRGB(255, 100, 110)

        warn("[OPSYX] Runtime error: " .. tostring(runError))

        Load1.Active = true
        Load2.Active = true
        loading = false
        return
    end

    Status.Text = name .. " loaded"
    Status.TextColor3 = Color3.fromRGB(100, 240, 170)

    task.wait(0.25)

    pcall(function()
        ScreenGui:Destroy()
    end)
end

