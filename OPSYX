    if not repaired then return false end
    OPSYX_PROTECT.repairs = OPSYX_PROTECT.repairs + 1
    OPSYX_PROTECT.last = "STATE_SANITIZED"
    OPSYX_PROTECT.lastT = os.clock()
    v39SetHealth("WATCHDOG","RECOVERED","Invalid state sanitized")
