        LAYOUT_CACHE.mobileDragged = ST.uiPositions.mobile and ST.uiPositions.mobile.dragged or false
        LAYOUT_CACHE.restoreDragged = ST.restoreBarDragged == true
        local lw, lh = vw / scale, vh / scale
