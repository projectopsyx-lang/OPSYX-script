local function makeButton(text, y, accent)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, -40, 0, 62)
    Button.Position = UDim2.fromOffset(20, y)
    Button.BackgroundColor3 = Color3.fromRGB(18, 27, 42)
    Button.BackgroundTransparency = 0
    Button.BorderSizePixel = 0
    Button.AutoButtonColor = false
    Button.Text = text
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 15
    Button.TextColor3 = Color3.fromRGB(235, 245, 255)
    Button.Parent = Main

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 12)

    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = accent
    ButtonStroke.Thickness = 1
    ButtonStroke.Transparency = 0.45
    ButtonStroke.Parent = Button

    Button.MouseEnter:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(25, 40, 60)
            }
        ):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = Color3.fromRGB(18, 27, 42)
            }
        ):Play()
    end)

    Button.MouseButton1Down:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.05),
            {
                Size = UDim2.new(1, -44, 0, 58)
            }
        ):Play()
    end)

    Button.MouseButton1Up:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.08),
            {
                Size = UDim2.new(1, -40, 0, 62)
            }
        ):Play()
    end)

    return Button
end

