local function oca(plr)
    if plr == ME then return end
    pcall(function()
        if CHAR_CONNS[plr] then
            pcall(function() CHAR_CONNS[plr]:Disconnect() end)
            CHAR_CONNS[plr] = nil
        end
        CHAR_CONNS[plr] = plr.CharacterAdded:Connect(function()
            local oldChar = CHARS[plr]
            tsp(function()
                tw(0.5)
                if plr.Parent ~= Players then return end
                destroyInstanceESP(plr)
                LP[plr]    = nil
                CHARS[plr] = nil
                if oldChar then
                    PART_CACHE_ROOT[oldChar] = nil
                    PART_CACHE_HEAD[oldChar] = nil
                    HUM_CACHE[oldChar]        = nil  -- [PERF-5]
                    clearLOSCForChar(oldChar)
                end
                if ST.tgpl == plr then flushTarget() end
            end)
        end)
    end)
end

