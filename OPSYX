local function distToPlayer(pl)
    local myChar = ME.Character; if not myChar then return math.huge end
    local myRoot = fr(myChar);   if not myRoot then return math.huge end
    local tc = pl.Character;     if not tc      then return math.huge end
    local tr = fr(tc);           if not tr       then return math.huge end
    return (myRoot.Position - tr.Position).Magnitude
end

-- ============================================================
-- TARGETING
-- ============================================================
local function ck(pl)
    if pl == ME then return false end
    if isIgnored(pl) then return false end
    local c = pl.Character
    return c and al(c)
end

-- [COMPAT-11] flushAimCache() removed: dead code never called anywhere.
-- clearHeadCache() and clearPartCache() are the live equivalents.

local SCAN      = {t=-999, n=0, hwm=0, items={}}
local SCAN_DT   = 1/144

local function currentScanDT()
    return FPS_SHOWN > 0 and FPS_SHOWN < 30 and (1/90) or SCAN_DT
end

local function doScan()
    local cam = CAM(); SCAN.n = 0
    if not cam then return end
    local all = Players:GetPlayers()
    local n = 0
    local cx, cy = cam.ViewportSize.X/2, cam.ViewportSize.Y/2
    local mousePos = UI:GetMouseLocation()
    local mx, my = mousePos.X, mousePos.Y
    local camPos = cam.CFrame.Position
    local useCen = not haveMouse()

    local function addPlayer(pl)
        if not ck(pl) then return end
        local c = pl.Character
        local rootPart = fp(c)
        local aimPart, aimName = getAimPart(c)
        if not rootPart or not aimPart then return end
        local ok2, sp, on = pcall(function()
            return cam:WorldToViewportPoint(aimPart.Position)
        end)
        if not ok2 or not on then return end
        n = n + 1
        local e = SCAN.items[n]
        if not e then e = {}; SCAN.items[n] = e end
        e.pl      = pl
        e.p       = rootPart
        e.aimP    = aimPart
        e.aimName = aimName
        e.cD = math.sqrt((sp.X-cx)^2 + (sp.Y-cy)^2)
        e.mD = useCen and e.cD or math.sqrt((sp.X-mx)^2 + (sp.Y-my)^2)
        e.md = (camPos - rootPart.Position).Magnitude
    end

    if ST.tgpl then addPlayer(ST.tgpl) end
    for i = 1, #all do
        local pl = all[i]
        if pl ~= ST.tgpl then addPlayer(pl) end
    end

    SCAN.n = n
    if n < SCAN.hwm then
        for i = n+1, SCAN.hwm do SCAN.items[i] = nil end
    end
    if n > SCAN.hwm then SCAN.hwm = n end
end

local function findTarget(fov, md, tc, wc, useCenter)
    local now = os.clock()
    if now - SCAN.t > currentScanDT() then SCAN.t = now; doScan() end
    local key        = useCenter and "cD" or "mD"
    local fovLimit   = fov or 999
    local lockedDist = (ST.tgpl ~= nil) and ST.tgDist or 999
    local switchThr  = lockedDist - LOCK_MARGIN
    local bestPart, bestAimPart, bestPl, bestDist, bestAimName =
        nil, nil, nil, fovLimit, "?"
    for i = 1, SCAN.n do
        local e = SCAN.items[i]
        local d = e[key]
        if d < fovLimit and e.md <= (md or 1000) then
            local okT = (not tc) or isEnemy(e.pl, tc)
            if okT and (not wc or los(e.aimP, e.pl.Character)) then
                if e.pl == ST.tgpl then
                    bestPart    = e.p;       bestAimPart = e.aimP
                    bestPl      = e.pl;      bestDist    = d
                    bestAimName = e.aimName
                    break
                elseif d < switchThr and d < bestDist then
                    bestDist    = d;         bestPart    = e.p
                    bestAimPart = e.aimP;    bestPl      = e.pl
                    bestAimName = e.aimName
                end
            end
        end
    end
    ST.tgDist     = bestPl ~= nil and bestDist or 999
    ST.tgPartName = bestAimName
    return bestAimPart, bestPl
end

-- ============================================================
-- PREDICTION
-- ============================================================
local LP = {}

local function pp(p, pl, pd)
    if pd <= 0 or not pl then return p.Position end
    local n   = os.clock()
    local pr2 = LP[pl]
    if not pr2 or n - pr2.t >= 0.001 then
        LP[pl] = {pos=p.Position, t=n}
    end
    if pr2 and n - pr2.t > 0.005 and n - pr2.t < 0.5 then
        local v = (p.Position - pr2.pos) / (n - pr2.t)
        if v.Magnitude > 500 then v = v * (500 / v.Magnitude) end
        return p.Position + v * pd
    end
    return p.Position
end

