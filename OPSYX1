        end
        C.v39SetHealth("WATCHDOG","READY","")
        if ST.tgpl and ST.tgpl.Parent ~= C.Players then
            C.flushTarget(); C.v39Recovery("target")
            C.v39SetHealth("AIMBOT","RECOVERED","Invalid target cleared")
