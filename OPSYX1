        if mk(inp,"am") then
            if S.AM.activationMode ~= "HOLD" and not holdToAimEnabled then
                S.AM.on = not S.AM.on
                if not S.AM.on and ST.tgpl ~= nil then flushTarget() end
                updBtn("AIMBOT", S.AM.on, C_GRN, C_RED)
