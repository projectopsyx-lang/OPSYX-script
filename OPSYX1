            elseif inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.MouseButton2
                or inp.UserInputType == Enum.UserInputType.MouseButton3
                or inp.UserInputType == Enum.UserInputType.MouseButton4
                or inp.UserInputType == Enum.UserInputType.MouseButton5 then
                nn = EN[inp.UserInputType] or tostring(inp.UserInputType):gsub("Enum.UserInputType.","")
            elseif inp.UserInputType ~= Enum.UserInputType.None
                and inp.UserInputType ~= Enum.UserInputType.MouseMovement
                and inp.UserInputType ~= Enum.UserInputType.MouseWheel
                and inp.UserInputType ~= Enum.UserInputType.Touch then
                nn = EN[inp.UserInputType] or tostring(inp.UserInputType):gsub("Enum.UserInputType.","")
            end

            if nn ~= nil then
                S.KB[rb.key] = nn
                local shown = nn ~= "" and nn or "NONE"
